<%
  var isContact = (page.path || '').indexOf('contact') === 0;
  var isAbout = (page.path || '').indexOf('about-us') === 0;
  var co = theme.company || {};
%>

<%- partial('_partial/page-head', {
  heading: page.title,
  subheading: isAbout ? '公司简介 · 经营范围 · 联系方式' : (isContact ? '电话 · 地址 · 邮箱 · 联系人' : ''),
  crumbs: [{ label: page.title }],
  total: null
}) %>

<div class="container section">
  <div class="page-layout<%= isContact ? ' page-layout--contact' : '' %>">
    <div class="page-content post-content">
      <%- page.content %>
    </div>

    <% if (isContact || isAbout) { %>
    <aside class="post-side">
      <div class="side-card side-card--contact">
        <h3 class="side-card__title">联系方式</h3>
        <ul class="side-contact">
          <li><span>公司</span><%- co.full_name || '' %></li>
          <li><span>地址</span><%- co.address || '' %></li>
          <li><span>电话</span><a href="tel:0757-22333012"><%- co.phone || '' %></a></li>
          <li><span>手机</span><%- co.mobile || '' %></li>
          <li><span>传真</span><%- co.fax || '' %></li>
          <li><span>邮箱</span><a href="mailto:<%= co.email %>"><%- co.email || '' %></a></li>
          <li><span>网址</span><a href="<%- co.site %>" target="_blank" rel="noopener"><%- co.site || '' %></a></li>
        </ul>
      </div>
      <div class="side-card">
        <h3 class="side-card__title">产品分类</h3>
        <ul class="side-cats">
          <% (theme.product_categories || []).forEach(function (name) { %>
          <li><a href="<%- cat_url(name) %>"><span><%- cat_name(name) %></span><em><%- cat_count(name) %></em></a></li>
          <% }) %>
        </ul>
      </div>
    </aside>
    <% } %>
  </div>
</div>
